<?xml version="1.0"?>
<Container version="2">
  <Name>HGXZ</Name>
  <Repository>wangxun2cyj1314/hgxz:latest</Repository>
  <Registry>https://hub.docker.com/r/wangxun2cyj1314/hgxz</Registry>
  <Network>bridge</Network>
  <MyIP/>
  <Shell>sh</Shell>
  <Privileged>false</Privileged>
  <Support/>
  <Project/>
  <Overview>黄果下载（HGXZ）：自动下载黄果短剧视频到指定目录，带 WebUI 管理界面。支持增量同步、失败重试、已有视频扫描识别，SQLite 记录下载状态。容器常驻运行，启动后立即同步一次，之后每天定时自动同步。</Overview>
  <Category>Downloaders:</Category>
  <WebUI>http://[IP]:[PORT:8099]</WebUI>
  <TemplateURL/>
  <Icon/>
  <ExtraParams>--restart unless-stopped</ExtraParams>
  <PostArgs>--daemon</PostArgs>
  <CPUset/>
  <DateInstalled/>
  <DonateText/>
  <DonateLink/>
  <Requires>私有镜像部署说明：&#xD;
1. 首次使用前，先在 Unraid 终端运行 docker login 登录你的 Docker Hub 账号以获取拉取权限。&#xD;
2. 启动容器前，先将 config.example.json 复制为 config.json 并放到 /mnt/user/appdata/HGXZ/config/ 目录下。</Requires>
  <Config Name="WebUI 端口" Target="8099" Default="8099" Mode="tcp" Description="WebUI 管理界面端口" Type="Port" Display="always" Required="true" Mask="false">8099</Config>
  <Config Name="配置文件目录" Target="/config" Default="/mnt/user/appdata/HGXZ/config" Mode="rw" Description="存放 config.json 的目录" Type="Path" Display="always" Required="true" Mask="false">/mnt/user/appdata/HGXZ/config</Config>
  <Config Name="状态库目录" Target="/data" Default="/mnt/user/appdata/HGXZ/data" Mode="rw" Description="SQLite 状态库存放目录" Type="Path" Display="always" Required="true" Mask="false">/mnt/user/appdata/HGXZ/data</Config>
  <Config Name="日志目录" Target="/logs" Default="/mnt/user/appdata/HGXZ/logs" Mode="rw" Description="同步日志目录" Type="Path" Display="always" Required="true" Mask="false">/mnt/user/appdata/HGXZ/logs</Config>
  <Config Name="媒体目录" Target="/media" Default="/mnt/user/QTZL/黄果" Mode="rw" Description="视频下载目标目录" Type="Path" Display="always" Required="true" Mask="false">/mnt/user/QTZL/黄果</Config>
  <Config Name="时区" Target="TZ" Default="Asia/Shanghai" Mode="" Description="容器时区" Type="Variable" Display="always" Required="true" Mask="false">Asia/Shanghai</Config>
  <Config Name="每日定时同步时间" Target="SCHEDULE" Default="03:30" Mode="" Description="每日自动同步时间，格式 HH:MM（默认凌晨 03:30）" Type="Variable" Display="always" Required="false" Mask="false">03:30</Config>
  <Config Name="HTTP 代理" Target="HTTP_PROXY" Default="" Mode="" Description="视频 CDN 下载代理；正常网络留空即可" Type="Variable" Display="advanced" Required="false" Mask="false"/>
  <Config Name="HTTPS 代理" Target="HTTPS_PROXY" Default="" Mode="" Description="同上；正常网络留空即可" Type="Variable" Display="advanced" Required="false" Mask="false"/>
  <Config Name="不走代理的地址" Target="NO_PROXY" Default="127.0.0.1,localhost" Mode="" Description="不走代理的本地地址，默认 127.0.0.1,localhost（主站与视频均走代理）" Type="Variable" Display="advanced" Required="false" Mask="false">127.0.0.1,localhost</Config>
  <Config Name="文件权限掩码" Target="UMASK" Default="000" Mode="" Description="新创建文件权限掩码，默认 000（避免 Unraid SMB 共享权限不足）" Type="Variable" Display="advanced" Required="false" Mask="false">000</Config>
</Container>
