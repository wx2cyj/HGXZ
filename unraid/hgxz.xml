<?xml version="1.0"?>
<Container version="2">
  <Name>HGXZ</Name>
  <Repository>hgxz:local</Repository>
  <Registry/>
  <Network>bridge</Network>
  <MyIP/>
  <Shell>sh</Shell>
  <Privileged>false</Privileged>
  <Support/>
  <Project/>
  <Overview>黄果下载（HGXZ）：自动下载黄果短剧视频到指定目录，带 WebUI 管理界面。支持增量同步、失败重试、已有视频扫描识别，SQLite 记录下载状态。容器常驻运行，启动后立即同步一次，之后每天定时自动同步。</Overview>
  <Category>Downloaders:</Category>
  <WebUI>http://[IP]:[PORT:8080]</WebUI>
  <TemplateURL/>
  <Icon/>
  <ExtraParams>--restart unless-stopped</ExtraParams>
  <PostArgs>--daemon --schedule 03:30</PostArgs>
  <CPUset/>
  <DateInstalled/>
  <DonateText/>
  <DonateLink/>
  <Requires>先在 Unraid 终端中构建本地镜像：进入项目目录执行 docker build -t hgxz:local .（构建后在添加容器界面选择本模板即可）。启动前需将 config.example.json 复制为 config.json 放入 appdata 的 config 目录。</Requires>
  <Config Name="WebUI 端口" Target="8080" Default="8080" Mode="tcp" Description="WebUI 管理界面端口" Type="Port" Display="always" Required="true" Mask="false">8080</Config>
  <Config Name="配置文件目录" Target="/config" Default="/mnt/user/appdata/hgxz/config" Mode="rw" Description="存放 config.json 的目录" Type="Path" Display="always" Required="true" Mask="false">/mnt/user/appdata/hgxz/config</Config>
  <Config Name="状态库目录" Target="/data" Default="/mnt/user/appdata/hgxz/data" Mode="rw" Description="SQLite 状态库存放目录" Type="Path" Display="always" Required="true" Mask="false">/mnt/user/appdata/hgxz/data</Config>
  <Config Name="日志目录" Target="/logs" Default="/mnt/user/appdata/hgxz/logs" Mode="rw" Description="同步日志目录" Type="Path" Display="always" Required="true" Mask="false">/mnt/user/appdata/hgxz/logs</Config>
  <Config Name="媒体目录" Target="/media" Default="/mnt/user/QTZL/黄果" Mode="rw" Description="视频下载目标目录" Type="Path" Display="always" Required="true" Mask="false">/mnt/user/QTZL/黄果</Config>
  <Config Name="时区" Target="TZ" Default="Asia/Shanghai" Mode="" Description="容器时区" Type="Variable" Display="always" Required="true" Mask="false">Asia/Shanghai</Config>
  <Config Name="HTTP 代理" Target="HTTP_PROXY" Default="http://192.168.2.6:10086" Mode="" Description="视频 CDN 下载代理；不需要可留空" Type="Variable" Display="advanced" Required="false" Mask="false">http://192.168.2.6:10086</Config>
  <Config Name="HTTPS 代理" Target="HTTPS_PROXY" Default="http://192.168.2.6:10086" Mode="" Description="同上" Type="Variable" Display="advanced" Required="false" Mask="false">http://192.168.2.6:10086</Config>
  <Config Name="不走代理的地址" Target="NO_PROXY" Default="127.0.0.1,localhost,huangguoai.com,rxzfszht.cc" Mode="" Description="站点域名直连，视频 CDN 走代理" Type="Variable" Display="advanced" Required="false" Mask="false">127.0.0.1,localhost,huangguoai.com,rxzfszht.cc</Config>
</Container>
